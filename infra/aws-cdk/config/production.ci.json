{
  "appName": "dify-fork-ci",
  "environment": {
    "account": "111111111111",
    "region": "us-east-1"
  },
  "network": {
    "maxAzs": 2,
    "natGateways": 1,
    "allowPublicIngress": false,
    "allowedIpv4Cidrs": [
      "10.0.0.0/8"
    ]
  },
  "enableExecuteCommand": false,
  "ecsEc2": {
    "instanceType": "m6i.large",
    "desiredInstances": 2,
    "minInstances": 1,
    "maxInstances": 3,
    "useSpotInstances": false
  },
  "images": {
    "api": "111111111111.dkr.ecr.us-east-1.amazonaws.com/dify-images:dify-api_ci",
    "web": "111111111111.dkr.ecr.us-east-1.amazonaws.com/dify-images:dify-web_ci",
    "sandbox": "langgenius/dify-sandbox:0.2.15",
    "pluginDaemon": "langgenius/dify-plugin-daemon:0.6.0-local",
    "ssrfProxy": "asset"
  },
  "storage": {
    "forceDestroy": false,
    "useManagedIamForS3": true
  },
  "database": {
    "defaultDatabaseName": "main",
    "pluginDatabaseName": "dify_plugin",
    "pgvectorDatabaseName": "pgvector",
    "minAcu": 0.5,
    "maxAcu": 2,
    "backupRetentionDays": 7,
    "deletionProtection": true,
    "pluginDbSslMode": "require"
  },
  "redis": {
    "nodeType": "cache.t4g.small",
    "multiAz": false,
    "replicasPerNodeGroup": 0,
    "sslCertReqs": "CERT_REQUIRED"
  },
  "services": {
    "web": {
      "cpu": 256,
      "memoryMiB": 1024,
      "desiredCount": 1,
      "minCount": 1,
      "maxCount": 2
    },
    "api": {
      "cpu": 512,
      "memoryMiB": 2048,
      "desiredCount": 1,
      "minCount": 1,
      "maxCount": 2
    },
    "worker": {
      "cpu": 512,
      "memoryMiB": 2048,
      "desiredCount": 1,
      "minCount": 1,
      "maxCount": 2
    },
    "workerBeat": {
      "cpu": 256,
      "memoryMiB": 512,
      "desiredCount": 1,
      "minCount": 1,
      "maxCount": 1
    },
    "sandbox": {
      "cpu": 256,
      "memoryMiB": 1024,
      "desiredCount": 1,
      "minCount": 1,
      "maxCount": 1
    },
    "pluginDaemon": {
      "cpu": 256,
      "memoryMiB": 1024,
      "desiredCount": 1,
      "minCount": 1,
      "maxCount": 1
    },
    "ssrfProxy": {
      "cpu": 256,
      "memoryMiB": 512,
      "desiredCount": 1,
      "minCount": 1,
      "maxCount": 1
    }
  },
  "app": {
    "logLevel": "INFO",
    "migrationEnabledOnApi": true,
    "allowWildcardCors": false,
    "corsAllowOrigins": "https://ci.example.com",
    "enableMarketplace": true,
    "textGenerationTimeoutMs": 600000,
    "gunicornTimeoutSeconds": 360,
    "celeryWorkerAmount": 2,
    "celeryAutoScale": false,
    "pluginMaxExecutionTimeoutSeconds": 600
  }
}
